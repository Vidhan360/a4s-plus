# ============================================================
# A4S+ — AI-Assisted Altitude Safety System
# Copy to .env and replace every CHANGE_ME value.
# NEVER commit a real .env file.
# ============================================================

# --- Core ---
A4S_ENV=development
A4S_DEBUG=true
A4S_LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
POSTGRES_USER=a4s
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=a4s
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Overrides the assembled URL when set. Must use the asyncpg driver.
# A4S_DATABASE_URL=postgresql+asyncpg://a4s:pass@localhost:5432/a4s

# --- Redis (WebSocket fan-out, rate limiting, simulation state) ---
REDIS_HOST=redis
REDIS_PORT=6379
# A4S_REDIS_URL=redis://localhost:6379/0

# --- Security ---
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
A4S_JWT_SECRET=CHANGE_ME_GENERATE_A_64_BYTE_RANDOM_SECRET
A4S_JWT_ALGORITHM=HS256
A4S_ACCESS_TOKEN_MINUTES=15
A4S_REFRESH_TOKEN_DAYS=7
A4S_MAX_FAILED_LOGINS=5
A4S_LOCKOUT_MINUTES=15
A4S_CORS_ORIGINS=http://localhost:3000
A4S_RATE_LIMIT_DEFAULT=200/minute
A4S_RATE_LIMIT_LOGIN=10/minute

# --- Seed demo accounts (seeding fails loudly if unset) ---
A4S_SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
A4S_SEED_COMMANDER_PASSWORD=CHANGE_ME_COMMANDER_PASSWORD
A4S_SEED_MEDICAL_PASSWORD=CHANGE_ME_MEDICAL_PASSWORD
A4S_SEED_OPERATOR_PASSWORD=CHANGE_ME_OPERATOR_PASSWORD
A4S_SEED_VIEWER_PASSWORD=CHANGE_ME_VIEWER_PASSWORD

# --- Simulation ---
A4S_SIM_TICK_SECONDS=2.0
A4S_SIM_DEFAULT_SEED=20260909
A4S_SIM_AUTOSTART=false

# --- ML ---
A4S_ML_ARTIFACT_DIR=ml/artifacts
A4S_ML_ACTIVE_MODEL=lstm

# --- Frontend (build + runtime) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
